<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>캘린더 & 메모 - 2026 / 2027</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 { color: #fff; margin-bottom: 15px; font-size: 28px; text-shadow: 0 2px 4px rgba(0,0,0,.3); }
  .controls { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; }
  .controls button {
    background: rgba(255,255,255,.2); color: #fff; border: none;
    padding: 10px 20px; border-radius: 25px; cursor: pointer;
    font-size: 16px; transition: .2s;
  }
  .controls button:hover { background: rgba(255,255,255,.4); }
  #monthLabel { color: #fff; font-size: 22px; font-weight: bold; min-width: 130px; text-align: center; }
  .calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    background: rgba(255,255,255,.15);
    padding: 15px;
    border-radius: 16px;
    max-width: 800px;
    width: 100%;
  }
  .weekday {
    text-align: center; color: #ffe6ff; font-weight: bold;
    padding: 8px 0; font-size: 14px;
  }
  .weekday.sun { color: #ffb3c6; }
  .weekday.sat { color: #b3e5fc; }
  .day {
    background: rgba(255,255,255,.9);
    border-radius: 10px;
    min-height: 85px;
    padding: 6px;
    cursor: pointer;
    position: relative;
    transition: .15s;
    display: flex;
    flex-direction: column;
  }
  .day:hover { transform: scale(1.05); box-shadow: 0 4px 12px rgba(0,0,0,.25); }
  .day .num { font-size: 14px; font-weight: bold; color: #444; }
  .day.sun .num { color: #e53935; }
  .day.sat .num { color: #1e88e5; }
  .day.empty { background: transparent; cursor: default; }
  .day.empty:hover { transform: none; box-shadow: none; }
  .day.today { outline: 3px solid #ffd54f; }
  .memo-dot { margin-top: auto; }
  .memo-preview {
    font-size: 11px; color: #555; overflow: hidden;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    margin-top: 4px; word-break: break-all;
  }
  .badge {
    display: inline-block; background: #7c4dff; color: #fff;
    font-size: 10px; border-radius: 8px; padding: 1px 6px; margin-top: 2px;
  }
  /* 모달 */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.5);
    display: none; justify-content: center; align-items: center; z-index: 100;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: #fff; border-radius: 16px; padding: 25px;
    width: 90%; max-width: 420px;
    box-shadow: 0 10px 40px rgba(0,0,0,.4);
  }
  .modal h2 { font-size: 20px; margin-bottom: 15px; color: #333; }
  .modal textarea {
    width: 100%; height: 140px; border: 2px solid #ddd; border-radius: 10px;
    padding: 10px; font-size: 15px; font-family: inherit; resize: vertical;
  }
  .modal textarea:focus { border-color: #7c4dff; outline: none; }
  .modal-btns { display: flex; gap: 10px; margin-top: 15px; justify-content: flex-end; }
  .modal-btns button {
    padding: 10px 20px; border: none; border-radius: 8px;
    cursor: pointer; font-size: 14px; font-weight: bold; transition: .2s;
  }
  .btn-save { background: #7c4dff; color: #fff; }
  .btn-save:hover { background: #651fff; }
  .btn-delete { background: #ef5350; color: #fff; }
  .btn-delete:hover { background: #d32f2f; }
  .btn-close { background: #eee; color: #555; }
  .btn-close:hover { background: #ddd; }
</style>
</head>
<body>

<h1>📅 캘린더 메모장</h1>

<div class="controls">
  <button id="prevBtn">◀ 이전</button>
  <div id="monthLabel"></div>
  <button id="nextBtn">다음 ▶</button>
</div>

<div class="calendar" id="calendar"></div>

<div class="modal-overlay" id="overlay">
  <div class="modal">
    <h2 id="modalDate"></h2>
    <textarea id="memoText" placeholder="이 날짜의 메모를 입력하세요..."></textarea>
    <div class="modal-btns">
      <button class="btn-delete" id="deleteBtn">삭제</button>
      <button class="btn-close" id="closeBtn">닫기</button>
      <button class="btn-save" id="saveBtn">저장</button>
    </div>
  </div>
</div>

<script>
// ===== 설정 =====
const START_YEAR = 2026;
const END_YEAR   = 2027;

const calendarEl = document.getElementById('calendar');
const monthLabel = document.getElementById('monthLabel');
const overlay    = document.getElementById('overlay');
const modalDate  = document.getElementById('modalDate');
const memoText   = document.getElementById('memoText');

// 현재 표시 중인 연/월
let viewYear  = new Date().getFullYear();
let viewMonth = new Date().getMonth();
// 표시 범위 클리핑
if (viewYear < START_YEAR) { viewYear = START_YEAR; viewMonth = 0; }
if (viewYear > END_YEAR)   { viewYear = END_YEAR;   viewMonth = 11; }

let selectedDate = null;

// ===== 메모 저장/로드 (localStorage) =====
const KEY = 'calendarMemo';
function loadMemos() {
  try { return JSON.parse(localStorage.getItem(KEY)) || {}; }
  catch { return {}; }
}
function saveMemos(m) {
  localStorage.setItem(KEY, JSON.stringify(m));
}
function getMemo(dateStr) {
  return loadMemos()[dateStr] || '';
}

// ===== 날짜 포맷 =====
function fmt(y, m, d) {
  return `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
}

// ===== 캘린더 렌더링 =====
const WEEKDAYS = ['일','월','화','수','목','금','토'];

function render() {
  monthLabel.textContent = `${viewYear}년 ${viewMonth + 1}월`;
  calendarEl.innerHTML = '';

  // 요일 헤더
  WEEKDAYS.forEach((w, i) => {
    const el = document.createElement('div');
    el.className = 'weekday' + (i === 0 ? ' sun' : i === 6 ? ' sat' : '');
    el.textContent = w;
    calendarEl.appendChild(el);
  });

  const firstDay = new Date(viewYear, viewMonth, 1).getDay();
  const lastDate = new Date(viewYear, viewMonth + 1, 0).getDate();
  const todayStr = fmt(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());

  // 빈 칸
  for (let i = 0; i < firstDay; i++) {
    const el = document.createElement('div');
    el.className = 'day empty';
    calendarEl.appendChild(el);
  }

  const memos = loadMemos();

  // 날짜 칸
  for (let d = 1; d <= lastDate; d++) {
    const dateStr = fmt(viewYear, viewMonth, d);
    const dow = new Date(viewYear, viewMonth, d).getDay();
    const el = document.createElement('div');
    el.className = 'day'
      + (dow === 0 ? ' sun' : dow === 6 ? ' sat' : '')
      + (dateStr === todayStr ? ' today' : '');

    let html = `<span class="num">${d}</span>`;
    const memo = memos[dateStr];
    if (memo) {
      const lines = memo.split('\n').filter(l => l.trim());
      const preview = (lines[0] || '').slice(0, 30);
      html += `<span class="memo-preview">${escapeHtml(preview)}</span>`;
      if (lines.length > 1 || memo.length > 30) {
        html += `<span class="badge">메모 ${lines.length > 1 ? '+' + (lines.length - 1) : '…'}</span>`;
      }
      html += `<span class="memo-dot">📝</span>`;
    }
    el.innerHTML = html;
    el.addEventListener('click', () => openModal(dateStr));
    calendarEl.appendChild(el);
  }
}

function escapeHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;')
          .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ===== 모달 =====
function openModal(dateStr) {
  selectedDate = dateStr;
  modalDate.textContent = dateStr + ' 메모';
  memoText.value = getMemo(dateStr);
  overlay.classList.add('open');
  memoText.focus();
}
function closeModal() {
  overlay.classList.remove('open');
  selectedDate = null;
}

document.getElementById('saveBtn').addEventListener('click', () => {
  if (!selectedDate) return;
  const memos = loadMemos();
  const text = memoText.value.trim();
  if (text) memos[selectedDate] = memoText.value;
  else delete memos[selectedDate];
  saveMemos(memos);
  closeModal();
  render();
});

document.getElementById('deleteBtn').addEventListener('click', () => {
  if (!selectedDate) return;
  if (!confirm('이 날짜의 메모를 삭제하시겠습니까?')) return;
  const memos = loadMemos();
  delete memos[selectedDate];
  saveMemos(memos);
  closeModal();
  render();
});

document.getElementById('closeBtn').addEventListener('click', closeModal);
overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// Ctrl+S 저장
memoText.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
    e.preventDefault();
    document.getElementById('saveBtn').click();
  }
});

// ===== 월 이동 (범위 내에서만) =====
document.getElementById('prevBtn').addEventListener('click', () => {
  if (viewYear === START_YEAR && viewMonth === 0) return;
  viewMonth--;
  if (viewMonth < 0) { viewMonth = 11; viewYear--; }
  render();
});
document.getElementById('nextBtn').addEventListener('click', () => {
  if (viewYear === END_YEAR && viewMonth === 11) return;
  viewMonth++;
  if (viewMonth > 11) { viewMonth = 0; viewYear++; }
  render();
});

render();
</script>
</body>
</html>
